{
  "name": "mind_mirror_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:localhost": "expo start --localhost",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "android:prebuild": "expo prebuild --platform android",
    "android:assemble": "cd android && ./gradlew assembleRelease",
    "android:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "android:setup-gradle": "bash scripts/setup-gradle-offline.sh",
    "android:use-local-gradle": "bash scripts/use-local-gradle-zip.sh",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.96.1",
    "axios": "^1.14.0",
    "expo": "~55.0.11",
    "expo-constants": "~55.0.11",
    "expo-linking": "~55.0.11",
    "expo-router": "~55.0.10",
    "expo-secure-store": "~55.0.11",
    "expo-status-bar": "~55.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.83.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "~55.0.15",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.11",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
