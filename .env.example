# 本地复制为 .env：cp .env.example .env
# Expo 仅将 EXPO_PUBLIC_* 注入客户端，勿把敏感密钥写在可公开变量里。

# 后端 API 根 URL（需与 mind_mirror_api 路由一致，通常含 /api/v1）
# - 本机 / iOS 模拟器：http://localhost:3001/api/v1
# - Android 模拟器访问本机：http://10.0.2.2:3001/api/v1
# - 真机：http://<电脑局域网IP>:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# EAS 云端构建：不要在仓库里提交生产地址时，用下面之一注入 EXPO_PUBLIC_*（构建时会打进包内）
# - eas secret:create --name EXPO_PUBLIC_API_BASE_URL --value https://你的域名/api/v1 --type string
# - 或在 eas.json 对应 profile 下增加 "env": { "EXPO_PUBLIC_API_BASE_URL": "..." }（勿提交密钥）
